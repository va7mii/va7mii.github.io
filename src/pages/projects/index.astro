---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSortedProjects } from "@/utils/getSortedProjects";
import config from "@/config";

const projects = getSortedProjects(await getCollection("projects"));
---

<Layout title={`Projects | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Projects" pageDesc="Things I've built and hacked on.">
    <ul class="grid gap-6 sm:grid-cols-2">
      {projects.map(project => <ProjectCard {...project} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
