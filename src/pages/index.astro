---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSortedProjects } from "@/utils/getSortedProjects";
import profileImage from "@/assets/images/prof.png";
import Interests from "@/components/Interests.astro";
import { interests } from "@/data/interests";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const projects = getSortedProjects(await getCollection("projects"));
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="border-border flex flex-col-reverse gap-6 border-b pt-8 pb-6 sm:flex-row sm:items-start"
    >
      <div class="flex-1">
        <h1 class="my-4 text-4xl font-bold sm:my-6 sm:text-5xl">
          Hi, I'm Kevin
        </h1>
        <p class="min-h-[4.5em] text-lg sm:min-h-[3em] sm:text-xl">
          I'm exploring how
          <span class="sr-only">{interests.map(i => i.phrase).join("; ")}.</span
          >
          <span
            id="typed"
            aria-hidden="true"
            class="text-accent font-semibold"
            data-phrases={JSON.stringify(interests.map(i => i.phrase))}
            >{interests[0].phrase}</span
          ><span id="caret" class="text-accent" aria-hidden="true">▍</span>
        </p>
        <p class="mt-4">
          More
          <LinkButton
            class="hover:text-accent underline decoration-dashed underline-offset-4"
            href={getRelativeLocaleUrl(locale, "about")}
          >
            about me
          </LinkButton>, or see my
          <LinkButton
            class="hover:text-accent underline decoration-dashed underline-offset-4"
            href={getRelativeLocaleUrl(locale, "cv")}
          >
            CV
          </LinkButton>.
        </p>
        {
          socials.length > 0 && (
            <div class="mt-4 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
              <a
                target="_blank"
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
                class="ms-1 inline-block p-2 sm:p-1"
                aria-label="RSS Feed"
                title="RSS Feed"
              >
                <IconRss
                  width={20}
                  height={20}
                  class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
                />
                <span class="sr-only">RSS Feed</span>
              </a>
            </div>
          )
        }
      </div>
      <Image
        src={profileImage}
        alt="Kevin Zhang"
        width={240}
        loading="eager"
        class="w-40 self-center rounded-lg sm:mt-8 sm:w-56 sm:self-start"
      />
    </section>

    <Interests />

    {
      projects.length > 0 && (
        <section id="projects" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">{t.nav.projects}</h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2">
            {projects.slice(0, 4).map(project => (
              <ProjectCard {...project} />
            ))}
          </ul>
          <div class="mt-6 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, "projects")}>
              All Projects
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  #caret {
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #caret {
      display: none;
    }
  }
</style>

<script>
  // Typing animation for the hero line. Hovering or focusing an interest card
  // jumps to that card's phrase; cards highlight while their phrase shows.
  let timer: ReturnType<typeof setTimeout> | undefined;

  function startTyping() {
    clearTimeout(timer);
    const el = document.querySelector<HTMLElement>("#typed");
    if (!el) return;
    const phrases: string[] = JSON.parse(el.dataset.phrases ?? "[]");
    const cards = document.querySelectorAll<HTMLElement>(".interest-card");
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (phrases.length === 0) return;

    let index = 0;
    let chars = phrases[0].length;
    let deleting = false;
    let pinned = false;

    const highlight = () =>
      cards.forEach(card =>
        card.classList.toggle("is-active", Number(card.dataset.topic) === index)
      );

    const show = (i: number) => {
      index = i;
      chars = phrases[i].length;
      deleting = false;
      el.textContent = phrases[i];
      highlight();
    };

    cards.forEach(card => {
      const pick = () => {
        pinned = true;
        clearTimeout(timer);
        show(Number(card.dataset.topic));
      };
      const release = () => {
        pinned = false;
        clearTimeout(timer);
        if (!reduced) timer = setTimeout(tick, 2500);
      };
      card.addEventListener("mouseenter", pick);
      card.addEventListener("focus", pick);
      card.addEventListener("click", pick);
      card.addEventListener("mouseleave", release);
      card.addEventListener("blur", release);
    });

    highlight();
    if (reduced) return;

    function tick() {
      if (pinned) return;
      const phrase = phrases[index];
      if (!deleting && chars === phrase.length) {
        deleting = true;
        timer = setTimeout(tick, 2200);
        return;
      }
      if (deleting && chars === 0) {
        deleting = false;
        index = (index + 1) % phrases.length;
        highlight();
      }
      chars += deleting ? -1 : 1;
      el!.textContent = phrases[index].slice(0, chars);
      timer = setTimeout(tick, deleting ? 25 : 55);
    }

    timer = setTimeout(tick, 2200);
  }

  document.addEventListener("astro:page-load", startTyping);

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
