---
import { getRelativeLocaleUrl } from "astro:i18n";
import { interests } from "@/data/interests";

const locale = Astro.currentLocale ?? "en";
---

<section id="interests" class="border-border border-b pt-12 pb-8">
  <h2 class="text-2xl font-semibold tracking-wide">What I'm exploring</h2>
  <p class="text-muted-foreground mt-2">
    Three problems I keep coming back to. Hover or tap one.
  </p>
  <ul class="mt-6 grid gap-4 sm:grid-cols-3">
    {
      interests.map((item, i) => (
        <li
          class="interest-card border-border bg-background hover:border-accent focus-within:border-accent rounded-lg border p-4 transition-all"
          style={`--delay: ${i * 120}ms`}
          data-topic={i}
          tabindex="0"
        >
          <div class="text-accent mb-3 h-16">
            {item.key === "robotics" && (
              <svg viewBox="0 0 80 64" class="h-full" aria-hidden="true">
                <g
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 60h30" />
                  <path d="M25 60v-8" />
                  <g class="arm-lower">
                    <path d="M25 52 L25 30" />
                    <circle cx="25" cy="30" r="3" />
                    <g class="arm-upper">
                      <path d="M25 30 L50 22" />
                      <circle cx="50" cy="22" r="2.5" />
                      <g class="arm-grip">
                        <path d="M50 22 l8 -6 M50 22 l9 3" />
                      </g>
                    </g>
                  </g>
                </g>
                <rect
                  class="arm-box"
                  x="56"
                  y="48"
                  width="12"
                  height="12"
                  rx="2"
                  fill="currentColor"
                  opacity=".35"
                />
              </svg>
            )}
            {item.key === "genai" && (
              <svg viewBox="0 0 80 64" class="h-full" aria-hidden="true">
                <g
                  class="cube"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linejoin="round"
                >
                  <path d="M40 8 L62 20 L40 32 L18 20 Z" />
                  <path d="M18 20 V44 L40 56 V32" />
                  <path d="M62 20 V44 L40 56" />
                </g>
                <g fill="currentColor">
                  <circle class="spark s1" cx="10" cy="10" r="2.5" />
                  <circle class="spark s2" cx="70" cy="8" r="2" />
                  <circle class="spark s3" cx="72" cy="52" r="2.5" />
                  <circle class="spark s4" cx="8" cy="50" r="2" />
                </g>
              </svg>
            )}
            {item.key === "energy" && (
              <svg viewBox="0 0 80 64" class="h-full" aria-hidden="true">
                <g
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <path
                    class="flow"
                    d="M12 50 L40 14 L68 50 Z M40 14 V50 M12 50 H68"
                  />
                </g>
                <g fill="currentColor">
                  <circle cx="12" cy="50" r="5" />
                  <circle cx="40" cy="14" r="5" />
                  <circle cx="68" cy="50" r="5" />
                  <circle class="pulse" cx="40" cy="50" r="5" />
                </g>
              </svg>
            )}
          </div>
          <h3 class="text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm">{item.question}</p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {item.keywords.map(k => (
              <li class="bg-muted rounded px-2 py-0.5 text-xs">{k}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
  <p class="mt-6 text-sm">
    See what I've built so far on the
    <a
      href={getRelativeLocaleUrl(locale, "projects")}
      class="text-accent underline decoration-dashed underline-offset-4"
      >projects page</a
    >.
  </p>
</section>

<style>
  .interest-card {
    animation: rise 0.6s ease-out both;
    animation-delay: var(--delay);
  }
  .interest-card:hover,
  .interest-card:focus-within,
  .interest-card.is-active {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px -12px var(--accent);
  }
  .interest-card.is-active {
    border-color: var(--accent);
  }

  /* Robot arm: reach down, grab, lift */
  .arm-lower {
    transform-origin: 25px 52px;
    animation: lower 4s ease-in-out infinite;
  }
  .arm-upper {
    transform-origin: 25px 30px;
    animation: upper 4s ease-in-out infinite;
  }

  /* Generative: cube draws itself while sparks twinkle */
  .cube path {
    stroke-dasharray: 120;
    animation: draw 4s ease-in-out infinite;
  }
  .spark {
    animation: twinkle 2s ease-in-out infinite;
  }
  .s2 {
    animation-delay: 0.5s;
  }
  .s3 {
    animation-delay: 1s;
  }
  .s4 {
    animation-delay: 1.5s;
  }

  /* Energy: power flows along the grid */
  .flow {
    stroke-dasharray: 6 6;
    animation: flow 1.2s linear infinite;
  }
  .pulse {
    transform-origin: 40px 50px;
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes lower {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(25deg);
    }
  }
  @keyframes upper {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(30deg);
    }
  }
  @keyframes draw {
    0% {
      stroke-dashoffset: 120;
    }
    45%,
    80% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -120;
    }
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.15;
      transform: scale(0.6);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }
  .spark {
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -12;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.5);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interest-card,
    .interest-card *,
    .interest-card svg * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
